# deploy.sh 会自动生成 relay.env 和随机访问密钥；不要提交真实密钥。
# Docker 构建加速（可选）。NODE_IMAGE 可改为服务器可访问的 Node 22 Alpine 镜像。
# NPM_REGISTRY 可改为企业代理或 https://registry.npmmirror.com。
NODE_IMAGE=node:22-alpine
NPM_REGISTRY=https://registry.npmjs.org
# 无域名时留空；运行 ./deploy.sh --domain relay.example.com 可自动填写并启用 HTTPS。
DOMAIN=
# 协议 v3 准入根：relay 的 X25519 身份私钥（base64 32 字节）。deploy.sh 首次部署自动生成；
# 请勿轻易更换——所有桌面签发的设备准入令牌都绑定它，更换后手机需在局域网内重连续期。
RELAY_SECRET_KEY=
# 自托管可选访问密钥（叠加在 v3 准入证明之上的 Bearer 门槛）；deploy.sh 缺省自动生成。
RELAY_ACCESS_KEY=
# 公共实例（官方）：./deploy.sh --public 持久设为 true，不要求访问密钥；自托管保持 false。
RELAY_PUBLIC=false
RELAY_BIND=0.0.0.0
RELAY_PORT=8787
# Caddy 宿主机端口；容器内部仍使用 80/443。
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
# 多个外部 PWA origin 用英文逗号分隔；同源 PWA 无需填写。
CORS_ALLOWED_ORIGINS=
QUEUE_MAX=1000
QUEUE_TTL_HOURS=72
MAX_CHANNELS=4096
MAX_DEVICES_PER_CHANNEL=16
QUEUE_BYTES_MAX_MB=64
HEARTBEAT_MS=30000
MAX_BUFFERED_BYTES=1048576
TICKET_RATE_PER_MIN=60
# 单 IP 同时 WebSocket 连接上限；前置反代时必须 TRUST_PROXY=true，否则所有访客共享同一 IP。
MAX_CONNS_PER_IP=64
TRUST_PROXY=false
