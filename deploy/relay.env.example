# 复制为 relay.env 后修改；不要提交真实密钥。
DOMAIN=relay.example.com
RELAY_VERSION=0.1.0
RELAY_ACCESS_KEY=replace-with-openssl-rand-base64-32
ALLOW_LEGACY_WS=true
# 多个 PWA origin 用英文逗号分隔。
CORS_ALLOWED_ORIGINS=https://relay.example.com
QUEUE_MAX=1000
QUEUE_TTL_HOURS=72
MAX_CHANNELS=4096
MAX_DEVICES_PER_CHANNEL=16
QUEUE_BYTES_MAX_MB=64
HEARTBEAT_MS=30000
MAX_BUFFERED_BYTES=1048576
TICKET_RATE_PER_MIN=60
TRUST_PROXY=true
