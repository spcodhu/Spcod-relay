# deploy.sh 会自动生成 relay.env 和随机访问密钥；不要提交真实密钥。
# Docker 构建加速（可选）。NODE_IMAGE 可改为服务器可访问的 Node 22 Alpine 镜像。
# NPM_REGISTRY 可改为企业代理或 https://registry.npmmirror.com。
NODE_IMAGE=node:22-alpine
NPM_REGISTRY=https://registry.npmjs.org
# 无域名时留空；运行 ./deploy.sh --domain relay.example.com 可自动填写并启用 HTTPS。
DOMAIN=
RELAY_ACCESS_KEY=
# 仅官方公共中继使用：./deploy.sh --anonymous 会持久设为 true；自托管保持 false。
RELAY_ALLOW_ANONYMOUS=false
RELAY_BIND=0.0.0.0
RELAY_PORT=8787
# Caddy 宿主机端口；容器内部仍使用 80/443。
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
ALLOW_LEGACY_WS=true
# 多个外部 PWA origin 用英文逗号分隔；同源 PWA 无需填写。
CORS_ALLOWED_ORIGINS=
QUEUE_MAX=1000
QUEUE_TTL_HOURS=72
MAX_CHANNELS=4096
MAX_DEVICES_PER_CHANNEL=16
QUEUE_BYTES_MAX_MB=64
HEARTBEAT_MS=30000
MAX_BUFFERED_BYTES=1048576
TICKET_RATE_PER_MIN=60
TRUST_PROXY=false
